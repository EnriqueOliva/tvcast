# Local configuration. Copy config.example.json to config.json and edit.
config.json

# Runtime state: published items, resume positions, measured subtitle offsets
tvstate.json
state.json

# Logs written by start.ps1 and the subtitle queue
server.log
server.err
subtitle-queue.log

# Android build output and machine-specific SDK paths
firetv/build/
firetv/app/build/
firetv/.gradle/
firetv/local.properties
*.keystore

# Third-party binary, fetched separately
bin/yt-dlp.exe

# Built from bin/runhidden.cs, keeps the scheduled task from flashing a console
bin/runhidden.exe

# Scratch audio pulled by the sync measuring tools
tools/__pycache__/
*.wav

# Generated subtitles and the audio they came from
cache/

node_modules/

# Diagnostic cue dumps
cues.json

# Runtime logs and state backups
subtitle-queue.err
queue.pid
tvstate.json.backup
queue-ids.txt

# Phone app build output
android/build/
android/app/build/
android/.gradle/
android/local.properties
